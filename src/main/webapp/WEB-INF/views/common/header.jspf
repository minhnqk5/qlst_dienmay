<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" default="QLST Điện máy"/> · QLST Điện máy</title>
    <link rel="stylesheet" href="<c:url value='/assets/style.css'/>">
</head>
<body>

<header class="topbar">
    <a class="brand" href="<c:url value='/'/>">QLST Điện máy</a>

    <div class="user-box">
        <c:choose>
            <c:when test="${not empty sessionScope.SessionUsername}">
                <span class="user-name">
                    👤 <c:out value="${sessionScope.SessionUsername}"/>
                </span>

                <form method="post" action="<c:url value='/logout'/>">
                    <button type="submit" class="logout-btn">
                        Đăng xuất
                    </button>
                </form>
            </c:when>

            <c:otherwise>
                <a href="<c:url value='/login'/>">Đăng nhập</a>
            </c:otherwise>
        </c:choose>
    </div>
</header>

<main class="container">